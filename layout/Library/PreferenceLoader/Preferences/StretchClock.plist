<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>entry</key>
  <dict>
    <key>cell</key><string>PSLinkCell</string>
    <key>label</key><string>StretchClock</string>
  </dict>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>General</string>
      <key>footerText</key><string>Changes apply instantly. Go to the Lock Screen to see the result.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Enable tweak</string>
      <key>key</key><string>enabled</string>
      <key>default</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>CLOCK SIZE</string>
      <key>footerText</key><string>From 0.5 (smaller) to 5.0 (larger). 1.0 = system default. Scales the digits in both directions and keeps them sharp.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>size</string>
      <key>min</key><real>0.5</real>
      <key>max</key><real>5.0</real>
      <key>default</key><real>1.2</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>WIDTH STRETCH (X)</string>
      <key>footerText</key><string>Extra horizontal stretch, from 0.6 to 5.0. 1.0 = no change.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>stretchX</string>
      <key>min</key><real>0.6</real>
      <key>max</key><real>5.0</real>
      <key>default</key><real>1.0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>HEIGHT STRETCH (Y)</string>
      <key>footerText</key><string>Extra vertical stretch, from 0.6 to 5.0. 1.0 = no change.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>stretchY</string>
      <key>min</key><real>0.6</real>
      <key>max</key><real>5.0</real>
      <key>default</key><real>1.0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>HORIZONTAL OFFSET</string>
      <key>footerText</key><string>From -200 (left) to 200 (right). 0 = original position.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>offsetX</string>
      <key>min</key><real>-200</real>
      <key>max</key><real>200</real>
      <key>default</key><real>0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>VERTICAL OFFSET</string>
      <key>footerText</key><string>From -300 (up) to 300 (down). 0 = original position.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>offsetY</string>
      <key>min</key><real>-300</real>
      <key>max</key><real>300</real>
      <key>default</key><real>0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Date</string>
      <key>footerText</key><string>Hides the label that shows the current date above the clock.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Hide date</string>
      <key>key</key><string>hideDate</string>
      <key>default</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Debug</string>
      <key>footerText</key><string>Writes the Lock Screen view structure to /var/mobile/StretchClock.log. Turn it on if offset or date hiding does not work, and send the file to the developer.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Debug mode</string>
      <key>key</key><string>debug</string>
      <key>default</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
  </array>
  <key>title</key><string>StretchClock</string>
</dict>
</plist>
