<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>entry</key>
  <dict>
    <key>cell</key><string>PSLinkCell</string>
    <key>label</key><string>StretchClock</string>
  </dict>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Общее</string>
      <key>footerText</key><string>Изменения применяются сразу. Перейдите на экран блокировки, чтобы увидеть результат.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Включить твик</string>
      <key>key</key><string>enabled</string>
      <key>default</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Реальный размер шрифта</string>
      <key>key</key><string>realFont</string>
      <key>default</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Режим</string>
      <key>footerText</key><string>ВКЛ: меняется сам шрифт часов (чётко, как в iOS 26). ВЫКЛ: запасной режим, часы растягиваются как картинка. Если часы выглядят странно или не меняются, выключите.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>РАЗМЕР ЧАСОВ</string>
      <key>footerText</key><string>От 0.5 (меньше) до 2.5 (крупнее). 1.0 = как в системе. Меняет высоту и ширину цифр вместе.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>size</string>
      <key>min</key><real>0.5</real>
      <key>max</key><real>2.5</real>
      <key>default</key><real>1.2</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>РАСТЯЖЕНИЕ ПО ШИРИНЕ (X)</string>
      <key>footerText</key><string>Дополнительно шире или уже. 1.0 = без изменений.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>stretchX</string>
      <key>min</key><real>0.6</real>
      <key>max</key><real>1.8</real>
      <key>default</key><real>1.0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>РАСТЯЖЕНИЕ ПО ВЫСОТЕ (Y)</string>
      <key>footerText</key><string>Дополнительно выше или ниже. 1.0 = без изменений.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>stretchY</string>
      <key>min</key><real>0.6</real>
      <key>max</key><real>2.2</real>
      <key>default</key><real>1.0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>СДВИГ ВЛЕВО / ВПРАВО</string>
      <key>footerText</key><string>От -200 (влево) до 200 (вправо). 0 = на своём месте.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>offsetX</string>
      <key>min</key><real>-200</real>
      <key>max</key><real>200</real>
      <key>default</key><real>0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>СДВИГ ВВЕРХ / ВНИЗ</string>
      <key>footerText</key><string>От -300 (вверх) до 300 (вниз). 0 = на своём месте.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>offsetY</string>
      <key>min</key><real>-300</real>
      <key>max</key><real>300</real>
      <key>default</key><real>0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Дата</string>
      <key>footerText</key><string>Попытка скрыть дату над часами. Не гарантирована: зависит от версии iOS.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Скрыть дату</string>
      <key>key</key><string>hideDate</string>
      <key>default</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
  </array>
  <key>title</key><string>StretchClock</string>
</dict>
</plist>
