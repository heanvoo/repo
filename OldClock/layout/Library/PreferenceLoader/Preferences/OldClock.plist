<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>entry</key>
  <dict>
    <key>cell</key><string>PSLinkCell</string>
    <key>label</key><string>OldClock</string>
  </dict>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>General</string>
      <key>footerText</key><string>Old iOS 14/15 Lock Screen clock. Changes apply instantly, open the Lock Screen to see them. Do not use together with StretchClock.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Enabled</string>
      <key>key</key><string>enabled</string>
      <key>default</key><true/>
      <key>defaults</key><string>com.heanvoo.oldclock</string>
      <key>PostNotification</key><string>com.heanvoo.oldclock/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Date under the time</string>
      <key>key</key><string>dateBelow</string>
      <key>default</key><true/>
      <key>defaults</key><string>com.heanvoo.oldclock</string>
      <key>PostNotification</key><string>com.heanvoo.oldclock/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>CLOCK SIZE</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>size</string>
      <key>min</key><real>40</real>
      <key>max</key><real>140</real>
      <key>default</key><real>82</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.heanvoo.oldclock</string>
      <key>PostNotification</key><string>com.heanvoo.oldclock/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>DIGIT WEIGHT</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSegmentCell</string>
      <key>key</key><string>weight</string>
      <key>default</key><integer>2</integer>
      <key>validTitles</key>
      <array>
        <string>Ultralight</string>
        <string>Thin</string>
        <string>Light</string>
        <string>Regular</string>
      </array>
      <key>validValues</key>
      <array>
        <integer>0</integer>
        <integer>1</integer>
        <integer>2</integer>
        <integer>3</integer>
      </array>
      <key>defaults</key><string>com.heanvoo.oldclock</string>
      <key>PostNotification</key><string>com.heanvoo.oldclock/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>DATE SIZE</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>dateSize</string>
      <key>min</key><real>12</real>
      <key>max</key><real>34</real>
      <key>default</key><real>21</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.heanvoo.oldclock</string>
      <key>PostNotification</key><string>com.heanvoo.oldclock/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>VERTICAL OFFSET</string>
      <key>footerText</key><string>From -150 (up) to 150 (down). 0 = system position.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>offsetY</string>
      <key>min</key><real>-150</real>
      <key>max</key><real>150</real>
      <key>default</key><real>0</real>
      <key>showValue</key><true/>
      <key>isContinuous</key><false/>
      <key>defaults</key><string>com.heanvoo.oldclock</string>
      <key>PostNotification</key><string>com.heanvoo.oldclock/reload</string>
    </dict>
  </array>
  <key>title</key><string>OldClock</string>
</dict>
</plist>
