<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>entry</key>
  <dict>
    <key>cell</key><string>PSLinkCell</string>
    <key>label</key><string>StretchClock</string>
  </dict>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Часы на экране блокировки</string>
      <key>footerText</key><string>Изменения применяются сразу. Размер меняет часы пропорционально, растяжения добавляют вытягивание по осям.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Включить</string>
      <key>key</key><string>enabled</string>
      <key>default</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>size</string>
      <key>label</key><string>Размер</string>
      <key>min</key><real>0.5</real>
      <key>max</key><real>2.5</real>
      <key>default</key><real>1.2</real>
      <key>showValue</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>stretchY</string>
      <key>label</key><string>Растяжение по высоте</string>
      <key>min</key><real>0.7</real>
      <key>max</key><real>2.0</real>
      <key>default</key><real>1.15</real>
      <key>showValue</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>stretchX</string>
      <key>label</key><string>Растяжение по ширине</string>
      <key>min</key><real>0.7</real>
      <key>max</key><real>1.6</real>
      <key>default</key><real>1.0</real>
      <key>showValue</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Положение</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>offsetX</string>
      <key>label</key><string>Сдвиг по горизонтали</string>
      <key>min</key><real>-200</real>
      <key>max</key><real>200</real>
      <key>default</key><real>0</real>
      <key>showValue</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>key</key><string>offsetY</string>
      <key>label</key><string>Сдвиг по вертикали</string>
      <key>min</key><real>-300</real>
      <key>max</key><real>300</real>
      <key>default</key><real>0</real>
      <key>showValue</key><true/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Дата</string>
      <key>footerText</key><string>Работает как предположение. Если дата не скрылась, включите отладку и пришлите лог.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Скрыть дату</string>
      <key>key</key><string>hideDate</string>
      <key>default</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Дополнительно</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Режим отладки (лог в /var/mobile)</string>
      <key>key</key><string>debug</string>
      <key>default</key><false/>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
    <dict>
      <key>cell</key><string>PSEditTextCell</string>
      <key>label</key><string>Класс часов (необязательно)</string>
      <key>key</key><string>className</string>
      <key>placeholder</key><string>пусто = автопоиск</string>
      <key>defaults</key><string>com.stretchclock.tweak</string>
      <key>PostNotification</key><string>com.stretchclock.tweak/reload</string>
    </dict>
  </array>
  <key>title</key><string>StretchClock</string>
</dict>
</plist>
